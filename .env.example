# ============================================================================
# SUPABASE CONFIGURATION
# ============================================================================
# VITE_SUPABASE_URL: Your Supabase project URL
# Get this from: https://supabase.com/dashboard → Project Settings → API
VITE_SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"

# VITE_SUPABASE_ANON_KEY: Supabase anonymous key for client-side auth
# Get this from: https://supabase.com/dashboard → Project Settings → API
VITE_SUPABASE_ANON_KEY="sb_publishable_YOUR_ANON_KEY"

# ============================================================================
# CLAUDE AI CONFIGURATION (PRIMARY)
# ============================================================================
# CLAUDE_API_KEY: Required for Claude AI API calls (Anthropic)
# Primary AI service for high-quality pedagogical content generation
# Get this from: https://console.anthropic.com/account/keys
CLAUDE_API_KEY="sk-ant-YOUR_CLAUDE_API_KEY"

# ============================================================================
# DEEPSEEK AI CONFIGURATION (FALLBACK)
# ============================================================================
# VITE_DEEPSEEK_API_KEY: Deepseek AI API key - legacy/fallback service
# Get this from: https://platform.deepseek.com/api/keys
VITE_DEEPSEEK_API_KEY="sk-YOUR_DEEPSEEK_API_KEY"
